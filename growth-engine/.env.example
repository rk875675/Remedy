# ============ Text generation ============
# "cursor" = Cursor CLI (`agent`) using your Cursor plan's auto usage — no API key.
#   One-time setup: irm 'https://cursor.com/install?win32=true' | iex   then: agent login
# "gemini" = Gemini Flash free tier (needs GEMINI_API_KEY)
# "none"   = formula-based generation only
LLM_PROVIDER=cursor
# Comma-separated model list — one picked at random per call.
# Spreading across models reduces single-model throttling risk.
CURSOR_MODEL=auto,cursor-grok-4.6-high-fast
# Optional backup when LLM_PROVIDER=cursor, or primary when =gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============ LLM rate limiting ============
# Hard ceilings on Cursor CLI calls — defense-in-depth behind Cloudflare Access.
# If any limit is hit the call returns null and the pipeline falls back gracefully.
LLM_MAX_PER_MINUTE=4
LLM_MAX_PER_HOUR=30
LLM_MAX_PER_DAY=200
LLM_MAX_CONCURRENT=2

# ============ Slide hosting (Cloudflare R2, free tier) ============
# TikTok/Instagram pull slides from public HTTPS URLs.
# Cloudflare dashboard -> R2 -> create bucket -> enable public access (r2.dev or custom domain)
# -> Manage R2 API Tokens -> create token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# e.g. https://slides.remedyrecoveries.com  (custom domain on the R2 bucket)
R2_PUBLIC_BASE_URL=

# ============ TikTok (your own developer app, $0) ============
# Create at https://developers.tiktok.com -> Manage apps -> add "Login Kit" +
# "Content Posting API", scopes: user.info.basic, video.upload, video.publish, video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your TikTok app
TIKTOK_REDIRECT_URI=https://slide.remedyrecoveries.com/api/tiktok/callback
# MEDIA_UPLOAD = sends drafts to your TikTok inbox (works unaudited; you tap post in-app)
# DIRECT_POST  = fully automatic (public visibility requires TikTok's free app audit)
TIKTOK_POST_MODE=MEDIA_UPLOAD

# ============ Instagram / Facebook (Meta Graph API, $0) ============
# Unused when BrightBean is connected. Leave empty.
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ============ BrightBean Studio (preferred publisher) ============
# Organization Settings → API Keys → Issue new key.
# Permissions: create_posts, publish_directly, upload_media, view_analytics
# You can also paste the key in the dashboard Settings tab (live engine).
BRIGHTBEAN_TOKEN=
BRIGHTBEAN_BASE_URL=https://studio.brightbean.xyz

# ============ Behavior ============
# Comma-separated: tiktok,instagram,facebook
# YouTube is added automatically when BrightBean has a YouTube account (slideshow Short).
PLATFORMS=tiktok,instagram,facebook
POSTS_PER_DAY=10
# Daily generate cron timezone (4:30 AM). Default matches US Central.
CRON_TZ=America/Chicago
# Warm-up ramp: "day:cap" pairs. From day 1 post 2/day, day 8 -> 5/day, day 15 -> 10/day.
RAMP_SCHEDULE=1:2,8:5,15:10
# The date the ramp starts counting from (set this the day you start posting). Empty = ramp off.
RAMP_START_DATE=
# New slideshows / remakes / A/B variants. Ramp date does not turn this on.
GENERATE_ENABLED=false
# BrightBean metric pulls + diagnosis/evolve. Off until posts are measurable.
ANALYTICS_ENABLED=false
LEARNING_ENABLED=false
# Coming-soon CTA + caption (no App Store URL). Flip to false when the app is for sale.
PRELAUNCH=true
# Delete shorts 48h after publish. Keep false until you start posting.
EXPIRE_SHORTS=false
# When true, cron sends approved posts at their scheduled slot.
# Keep false until you want drafts (or live posts) to leave on a timer.
AUTO_PUBLISH=false
# When true, cron assigns times to every approved post. Keep false unless you want the ramp to fill the day.
AUTO_ASSIGN_SCHEDULE=false
# Native IG/FB only (no BrightBean). BrightBean IG/FB/YouTube always go live.
# TikTok is always a draft so you can add a sound.
LIVE_PUBLISH=false
# Confidence threshold (0-100) above which posts skip the approval queue.
# Set to 101 to always require approval.
AUTO_APPROVE_CONFIDENCE=101
# Disable all cron jobs (useful for dev)
DISABLE_CRON=false
# Optional: webhook pinged when the daily batch is ready for review
# (ntfy.sh topic URL, Discord webhook, or any URL accepting a POST)
NOTIFY_WEBHOOK_URL=
# Server port
PORT=3000

# ============ Studio login ============
# Shared studio password. One login per browser (~180-day cookie).
# Cloud: set as a Cloudflare Pages secret on the remedy-growth project:
#   npx wrangler pages secret put STUDIO_PASSWORD --project-name=remedy-growth
# Empty = no login gate (local dev default).
STUDIO_PASSWORD=

# ============ UGC creators ============
# Restricted dashboard role is unused on the password-only cloud login (everyone is operator).
# Local/PC still maps Cloudflare Access email if those headers are present.
# UGC_OPERATOR_EMAILS=you@example.com
# UGC_CREATORS=sohan:sohan@example.com
UGC_OPERATOR_EMAILS=
UGC_CREATORS=
