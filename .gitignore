# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Env files — keep only .env.example tracked (placeholders, no real values).
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local link/cache (project ref, pooler host — not secrets, but machine-local)
supabase/.temp/

# Local script scratch: EAS build logs here echo the EXPO_PUBLIC_* values back. Those keys
# are public by design, but build logs and generated media don't belong in the repo.
scripts/output/

# Miniflare/Wrangler local state — a throwaway cache that includes copies of R2 video
# blobs. Regenerated on demand; committing it would put media in git history for good.
.wrangler/
growth-engine/.wrangler/

# Generated marketing renders (slides, thumbs, snapshots). Reproducible from the
# growth-engine CLI, and ~76 MB per full run.
growth-engine/output/
